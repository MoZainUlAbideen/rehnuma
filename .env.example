# Copy to .env (which is git-ignored) and fill in.
GROQ_API_KEY=
# Optional. If Groq says the model doesn't exist, pick a current one from console.groq.com
REHNUMA_LLM_MODEL=openai/gpt-oss-120b

# Bill-photo reading (milestone 3). Free key: https://aistudio.google.com -> Get API key
GEMINI_API_KEY=
# Optional; list yours with: uv run rehnuma-eval-extract --list-models
REHNUMA_VISION_MODEL=gemini-3.5-flash

# Tracing (milestone 6) - optional. Free account: https://cloud.langfuse.com -> project ->
# Settings -> API keys. Needs: uv sync --extra obs. Leave empty to switch tracing off.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU (default) or https://us.cloud.langfuse.com if you created the project in the US region
LANGFUSE_BASE_URL=https://cloud.langfuse.com
